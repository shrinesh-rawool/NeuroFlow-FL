# ---- Base stage: system utilities + python packages ----
FROM python:3.11-slim AS base

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    tar \
    gzip \
    procps \
    git \
    build-essential \
    openssh-client \
    libgl1 \
    libxrender1 \
    libxext6 \
    libsm6 \
    && rm -rf /var/lib/apt/lists/*

# Large dependency installed separately
RUN pip install --no-cache-dir --default-timeout=1000 --retries 10 eclipse-sumo

# Python dependencies
RUN pip install --no-cache-dir --default-timeout=1000 --retries 10 \
    traci \
    gymnasium \
    flwr \
    numpy \
    pandas \
    matplotlib \
    seaborn \
    tensorboard \
    cloudpickle \
    "gymnasium[other]" && \
    pip install --no-cache-dir --default-timeout=1000 --retries 10 --no-deps stable_baselines3

WORKDIR /app

# ---- CPU target ----
FROM base AS cpu
RUN pip3 install --no-cache-dir --default-timeout=1000 --retries 10 torch torchvision --index-url https://download.pytorch.org/whl/cpu
CMD ["sleep", "infinity"]

# ---- GPU target ----
FROM base AS gpu
RUN pip3 install --no-cache-dir --default-timeout=1000 --retries 10 torch torchvision --index-url https://download.pytorch.org/whl/cu132
CMD ["sleep", "infinity"]
