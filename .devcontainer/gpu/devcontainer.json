{
  "name": "NeuroFlow-FL (GPU)",
  "build": {
    "dockerfile": "../Dockerfile.dev",
    "context": "../..",
    "target": "gpu"
  },
  "workspaceFolder": "/app",
  "workspaceMount": "source=${localWorkspaceFolder},target=/app,type=bind",
  "overrideCommand": false,
  "runArgs": [
    "--gpus=all",
    "-v",
    "${localEnv:HOME}/.ssh:/root/.ssh:ro"
  ],
  "postStartCommand": "git config --global --add safe.directory /app || true",
  "forwardPorts": [6006],
  "remoteUser": "root"
}
